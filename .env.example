# Copy this file to .env.local and fill in real values.
# All of these also need to be added in Vercel → Project Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend → API Keys (sign up using amalmnair9@gmail.com)
RESEND_API_KEY=

# Where booking notification emails are sent
ADMIN_NOTIFICATION_EMAIL=amalmnair9@gmail.com

# Used only for the "review in admin" link inside notification emails.
# Set to the real deployed URL in Vercel; leave as localhost for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AI Studio (aistudio.google.com) → Get API key. Free tier, no card
# required. Optional — without it, the "Suggest with AI" buttons in the
# admin content editor and the concierge chatbot just don't appear.
GEMINI_API_KEY=

# Stripe → Developers → API keys. TEST MODE ONLY — use the sk_test_... key,
# never sk_live_. Optional — without it, confirming a booking just skips
# generating a payment link (guests still pay on arrival as the default).
STRIPE_SECRET_KEY=

# Stripe → Developers → Webhooks → your endpoint → Signing secret. Only
# obtainable after the webhook endpoint is deployed and registered with
# Stripe (see docs/LEARNING_GUIDE.md) — leave blank until then.
STRIPE_WEBHOOK_SECRET=
